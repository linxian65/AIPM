# Neon Postgres 双 URL 配置
# DATABASE_URL: 池化连接（pgBouncer / Neon Pooler），用于运行时 + Vercel Edge/Serverless，
#          接受高吞吐短连接；端口通常 6543
# DIRECT_URL:  直连 Neon（绕过连接池），用于 prisma migrate / db push / introspection 等
#          需要长连接或会话能力的操作；端口通常 5432
# 本地开发与 Vercel 部署共用同一对值（Neon 控制台 → Connection Details 复制）
DATABASE_URL=
DIRECT_URL=

# Anthropic
ANTHROPIC_API_KEY=
# 可选，默认 claude-sonnet-5
ANTHROPIC_MODEL=